rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --- Funciones de Ayuda ---
    function isPublicAppPath(appId) {
     return appId == '1:786390581865:web:ed47531cf7415ae5ca18f8';
    }

    function isAllowedReceiptType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf' ||
             request.resource.contentType == 'application/octet-stream';
    }

    // El claim "staff" lo otorga la Cloud Function ensureStaffClaim (ver
    // functions/index.js). El chequeo por email queda como red de
    // contención hasta confirmar que todas las cuentas de staff ya tienen
    // el claim en su token (ver mismo comentario en firestore.rules).
    function isStaff() {
      return request.auth != null &&
             (request.auth.token.staff == true ||
              request.auth.token.email in [
               'sandrupaloschi@gmail.com',
               'gracielamargheritis8@gmail.com',
               'javicampa010@gmail.com'
             ]);
    }

    // --- Reglas Específicas ---

    // FOTOS DE PERFIL
    // El plan era exigir request.auth.uid == studentId acá (loginStudent
    // ata la sesión a un custom token tras validar DNI+PIN) para que solo
    // el propio alumno pudiera tocar su foto -- revertido temporalmente:
    // a la cuenta de servicio de las Functions le falta el permiso IAM
    // "Service Account Token Creator" (rol "roles/iam.serviceAccountTokenCreator",
    // distinto del que ya se agregó para poder deployar) para firmar ese
    // token, así que NINGÚN alumno llegaba a tener uid == studentId y
    // quedaban todos bloqueados para cambiar su propia foto. Hasta que se
    // otorgue ese permiso, vuelve a alcanzar con estar autenticado (como
    // antes de esa migración) -- sigue haciendo falta studentId para saber
    // a quién pisarle la foto, así que no es un visitante 100% anónimo sin
    // ningún contexto, pero no verifica identidad real todavía.
    match /students/{studentId}/profilePicture.jpg {
      allow read: if true;
      allow write: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // COMPROBANTES
    match /artifacts/{appId}/students/{studentId}/receipts/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                     && isPublicAppPath(appId)
                     && request.resource.size < 15 * 1024 * 1024
                     && isAllowedReceiptType();
    }

    // GRABACIONES DE VOZ (Herramientas → Grabador de voz → "Enviar a Sandra")
    // El borrado va separado de la subida: en un delete, Storage no completa
    // request.resource, así que un solo "allow write" que lo referencia
    // rechaza cualquier intento de borrar (el alumno o el admin ven "Borrar"
    // funcionar en la lista, pero el archivo real queda huérfano en Storage).
    match /artifacts/{appId}/students/{studentId}/voiceNotes/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                     && isPublicAppPath(appId)
                     && request.resource.size < 15 * 1024 * 1024
                     && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && isPublicAppPath(appId);
    }

    // --- REGLA PARA LENCERÍA (CON EL AJUSTE PARA GALERÍAS) ---
    // Permite lectura pública de todas las fotos, pero solo el staff puede subir/borrar.
    match /artifacts/{appId}/lenceriaStock/{itemId}/{allPaths=**} {
       allow read: if true;
       allow write: if isStaff()
                     && request.resource.size < 5 * 1024 * 1024
                     && request.resource.contentType.matches('image/.*');
     }

  }
}
